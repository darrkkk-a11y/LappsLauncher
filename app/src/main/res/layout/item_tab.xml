<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center" android:paddingVertical="4dp">
    <ImageView android:id="@+id/tabIcon" android:layout_width="26dp" android:layout_height="26dp"
        android:src="@drawable/ic_folder"/>
    <TextView android:id="@+id/tabLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="11sp" android:textColor="@color/tab_inactive" android:paddingTop="2dp"
        android:text="@string/tab_files"/>
</LinearLayout>
