<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/ios_bg">
    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal"
            android:padding="32dp">

            <ImageView android:layout_width="96dp" android:layout_height="96dp"
                android:src="@drawable/ic_box" android:background="@drawable/tab_icon_bg"
                android:padding="20dp"/>

            <TextView style="@style/Ios.LargeTitle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="24dp"
                android:textSize="28sp" android:text="@string/ob_title"/>

            <TextView style="@style/Ios.Subtitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:textSize="15sp" android:gravity="center" android:text="@string/ob_text"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnStart"
                style="@style/Ios.Button" android:layout_width="240dp" android:layout_height="52dp"
                android:layout_marginTop="28dp" android:textSize="17sp" android:text="@string/ob_start"/>

            <!-- Прогресс -->
            <LinearLayout android:id="@+id/progressBlock" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:visibility="gone" android:layout_marginTop="24dp">
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressBar" android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView android:id="@+id/stepLabel" style="@style/Ios.Title2"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"/>
                <TextView android:id="@+id/logView" android:layout_width="match_parent"
                    android:layout_height="180dp" android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card" android:padding="12dp"
                    android:fontFamily="monospace" android:textSize="11sp"
                    android:textColor="@color/ios_secondary" android:scrollbars="vertical"
                    android:maxLines="200"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
